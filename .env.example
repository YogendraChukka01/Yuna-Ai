# Read ONLY by the local agent process (never by the UI bundle).
OPENCODE_API_KEY=
# provider/model as printed by `opencode models` (blank = OpenCode default)
OPENCODE_MODEL=
# Optional: use an already-running OpenCode server instead of spawning one
OPENCODE_SERVER_URL=
ARU_DATA_DIR=
ARU_BROWSER_PROFILE=
# chrome | chromium  (chrome = installed Google Chrome, dedicated ARU profile)
ARU_BROWSER_CHANNEL=chrome
