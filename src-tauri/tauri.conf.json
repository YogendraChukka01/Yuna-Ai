{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuna",
  "version": "0.1.0",
  "identifier": "dev.yuna.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main", "title": "Yuna", "width": 340, "height": 90,
        "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true,
        "resizable": false, "shadow": false, "center": false, "x": 0, "y": 0, "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:47821 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
